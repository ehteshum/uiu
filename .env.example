VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Steps:
# 1. Create a free Supabase project at https://app.supabase.com
# 2. Create table `settings` with columns: key text PRIMARY KEY, value text, updated_at timestamptz
# 3. Insert initial row:
#    INSERT INTO public.settings (key, value) VALUES ('tuition_deadline', '2026-06-01T00:00:00Z') ON CONFLICT DO NOTHING;
# 4. Configure RLS and `profiles` table so only admins can update `settings`.
# Optional: comma-separated admin emails (used by client-side admin page)
# VITE_ADMIN_EMAILS=you@example.com,other@domain.com
